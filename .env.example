# LLM provider: openai | openrouter | ollama
LLM_PROVIDER=openrouter
MODEL_NAME=deepseek/deepseek-r1-0528:free

# OpenAI
OPENAI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Ollama local (optional)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama

# Mobile API bridge
MOBILE_API_HOST=0.0.0.0
MOBILE_API_PORT=8000
MOBILE_API_CORS_ORIGINS=*

# Android app default endpoint (can be changed in UI)
NANYIA_API_URL=http://127.0.0.1:8000/chat

# Discord bot (New Clan)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_ALERT_CHANNEL_ID=
DISCORD_TICKET_CATEGORY_ID=
DISCORD_MUTED_ROLE_NAME=Mutado
